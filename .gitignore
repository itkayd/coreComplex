node_modules/
dist/
*.log
.DS_Store
coverage/
/packs/
apps/web/dist/
# Built pack output. A negation cannot re-include a file whose parent directory
# is excluded, so exclude the CONTENTS and then re-include the one source asset.
apps/web/public/packs/*
# The HSK word lists are a committed SOURCE asset, not build output: deriving
# them needs the network, and no build may depend on that.
!apps/web/public/packs/hsk-bands.json
models/
pretrained_models/
.cache/
*.pt
*.onnx
*.safetensors
*.ckpt

# Locally supplied source files: structure and manifests are tracked, bytes are not.
sources/inbox/**/*
!sources/inbox/**/
!sources/inbox/**/.gitkeep
!sources/inbox/**/manifest.json
!sources/inbox/**/candidates.json

# Review artefacts: the reviews themselves ARE the release input and are
# tracked; generated templates and the derived certified snapshot are not.
sources/review/audio/reviews.template.json
sources/review/audio/certified.json

# Browser-gate output.
artifacts/
apps/web/dist-fixture/

# Secrets. The database URL lives in Vercel's encrypted env vars, never here.
.env
.env.*
!.env.example
.vercel
