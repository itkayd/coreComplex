# Postgres connection string for the optional learning-log backup.
#
# NEVER commit the real value. Set it in Vercel:
#   Project → Settings → Environment Variables → DATABASE_URL
# and locally in a .env file, which is git-ignored.
#
# Without it the app runs entirely offline-first and the backup control is
# hidden — no database is a supported configuration, not an error.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
