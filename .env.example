# Supabase credentials for the optional learning-log backup.
#
# On Vercel these are injected by the official Supabase Marketplace integration
# and there is nothing to set by hand. Copy them here only for local development.
#
# NEVER commit the real values. The repository is public; the secret key grants
# full, RLS-bypassing access to the project.
#
# SUPABASE_SECRET_KEY is the modern name. Older projects were provisioned with
# SUPABASE_SERVICE_ROLE_KEY, which the API still accepts as a fallback.
#
# The publishable/anon key is deliberately NOT usable here: the table has Row
# Level Security on with no public policy, so an anon key would produce a backup
# that reports success and stores nothing. The API refuses it and says so.
#
# Without these the app runs entirely offline-first and the backup control is
# hidden — no database is a supported configuration, not an error.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Cloudflare Workers AI — the LAST tier of "Hear it".
#
# Used only on a device with no local speech service AND no Mandarin voice of
# its own: a locked-down Android with no Chinese voice pack, a desktop Linux
# browser with no zh-CN voice, or a device whose only Chinese voice is Cantonese
# (refused outright — a Cantonese reading of a Mandarin word is a wrong answer).
#
# Off unless BOTH are set; the chain simply ends a step earlier without them.
#
# The token is a bearer credential for an account-wide AI endpoint. It is read
# only by the serverless function, never by the browser, and never through a
# NEXT_PUBLIC_/VITE_ name — those are exposed to client bundles by definition.
# A test scans the built bundle for both values.
#
# Model: @cf/myshell-ai/melotts (fixed in api/tts.ts, part of the cache key).
#
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-workers-ai-token
