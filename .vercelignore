# Patterns are anchored with a leading slash. Unanchored names match at ANY
# depth, so a bare "sources" would also exclude packages/content/src/sources —
# which is part of the build.

# Test files must not become deployed routes: Vercel turns every file under
# api/ into a serverless function, so api/api.test.ts would be published at
# /api/api.test.
api/*.test.ts

# Not needed to build or serve the app.
/docs
/sources
# Database migrations are applied to Supabase directly, never by the deployment.
/supabase
/artifacts
/apps/web/e2e
/apps/web/dist-fixture
